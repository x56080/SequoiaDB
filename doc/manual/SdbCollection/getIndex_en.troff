\ \ \ \ \ },
\ \ \ \ \ "v":\ 0,
\ \ \ \ "unique":\ true,
\ \ \ \ \ "dropDups":\ false,
\ \ \ \ \ "enforced":\ false,
\ \ \ \ \ "NotNull":\ false,
\ \ \ \ \ "NotArray":\ false
\ \ },
\ \ "IndexFlag":\ "Normal",
\ \ "Type":\ "Positive"
}
